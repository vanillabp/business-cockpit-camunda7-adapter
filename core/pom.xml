<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.vanillabp.businesscockpit</groupId>
    <artifactId>businesscockpit-camunda7-adapter-parent</artifactId>
    <version>0.9.0-SNAPSHOT</version>
  </parent>

  <artifactId>businesscockpit-camunda7-adapter</artifactId>
  <name>VanillaBP Business Cockpit adapter for Camunda 7 - Core</name>
  <description>Everything the Business Cockpit extension does with an embedded Camunda 7 engine and without knowing a platform: the engine customizer adding the task listeners and the history handler, and the bridge answering what the cockpit reads about a task or a workflow.</description>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>VanillaBP</id>
      <organization>Phactum Softwareentwicklung GmbH</organization>
      <organizationUrl>https://www.phactum.at</organizationUrl>
    </developer>
  </developers>

  <!-- No platform integration is a dependency here, deliberately: this module compiles
       against the extension SPI, the platform-neutral half of the cockpit extension and the
       CORE artifact of the VanillaBP Camunda 7 adapter, and against nothing which exists only
       on Spring Boot or only on Quarkus. -->

  <dependencies>
    <dependency>
      <groupId>io.vanillabp.businesscockpit</groupId>
      <artifactId>extensions-commons</artifactId>
    </dependency>
    <dependency>
      <!-- names the processing context this extension is wired with, and holds the engine
           customizer its listeners are installed through. It brings the Camunda engine and
           the VanillaBP SPI artifacts along. -->
      <groupId>io.vanillabp</groupId>
      <artifactId>camunda7-adapter</artifactId>
    </dependency>
    <dependency>
      <!-- arrives transitively as well; declared because this module implements it -->
      <groupId>io.vanillabp</groupId>
      <artifactId>vanillabp-extension-spi</artifactId>
    </dependency>
    <dependency>
      <!-- the adapter SPI, for WorkflowTaskWiring alone: the core answers there whether a called
        process shares the workflow aggregate of its caller (decision 3 in the repository's
        DECISIONS.md). The narrow WorkflowTaskClaims of the integration SPI does not offer that
        question yet. Everything else this module asks VanillaBP is a type of the extension SPI
        or of the integration SPI. The artifact arrives through the Camunda 7 adapter as well. -->
      <groupId>io.vanillabp</groupId>
      <artifactId>vanillabp-adapter-spi</artifactId>
    </dependency>
    <dependency>
      <groupId>org.camunda.bpm</groupId>
      <artifactId>camunda-engine</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- brings the output suppression every VanillaBP test class registers, and with it the
        Mockito the engine's own types are stood in with -->
      <groupId>io.vanillabp</groupId>
      <artifactId>test-utils</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- the core's own name-clash avoidance, so a test asks the real one what an engine calls
        a process instead of teaching a double to answer -->
      <groupId>io.vanillabp.adapter</groupId>
      <artifactId>migration-adapter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- the database a test builds a real engine on: what this module contributes to an
        engine is only true of an engine which was built, and a mocked configuration answers
        whatever it was taught -->
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <!-- the parent's rule, without the adapter SPI. This module still declares it, and the
          comment at the dependency says why -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>an-extension-depends-on-the-extension-spi-alone</id>
            <configuration>
              <rules>
                <bannedDependencies>
                  <excludes combine.self="override">
                    <exclude>io.vanillabp.adapter:migration-adapter:*:*:compile</exclude>
                    <exclude>io.vanillabp:vanillabp-spring-boot-integration:*:*:compile</exclude>
                    <exclude>io.vanillabp:vanillabp-quarkus-integration:*:*:compile</exclude>
                    <exclude>io.vanillabp.adapter:migration-adapter:*:*:provided</exclude>
                    <exclude>io.vanillabp:vanillabp-spring-boot-integration:*:*:provided</exclude>
                    <exclude>io.vanillabp:vanillabp-quarkus-integration:*:*:provided</exclude>
                    <exclude>io.vanillabp.adapter:migration-adapter:*:*:runtime</exclude>
                    <exclude>io.vanillabp:vanillabp-spring-boot-integration:*:*:runtime</exclude>
                    <exclude>io.vanillabp:vanillabp-quarkus-integration:*:*:runtime</exclude>
                  </excludes>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
